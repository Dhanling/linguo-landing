# Contoh variabel lingkungan linguo-landing. Salin ke .env.local lalu isi.
# JANGAN commit nilai asli.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# [ai-funnel-v1] LLM untuk Konsultan Linguo (/konsultasi) — format OpenAI chat/completions.
# Kosong = pakai DeepSeek lewat DEEPSEEK_API_KEY / DEEPSEEK_MODEL di bawah.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# DeepSeek (dipakai juga oleh chat Minling)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
