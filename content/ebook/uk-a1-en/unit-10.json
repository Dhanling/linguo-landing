{
  "title": "Where do you live?",
  "title_target": "Де ти живеш? — De ty zhyvesh?",
  "goal": "Say where you live, work, and are — and master the sixth case (місцевий, the locative), the only case that never appears without a preposition.",
  "bekal": [
    "ask and answer \"where do you live?\"",
    "put place names into the місцевий",
    "choose between в and на",
    "conjugate the verb жити",
    "describe where you live"
  ],
  "dialogs": [
    {
      "title": "Діалог — After class, waiting for the bus",
      "intro": "Oksana and Ani are chatting at the bus stop. Every place name in this dialogue ends in **-і** — that's the hallmark of the sixth case, and it has hardly any exceptions.",
      "lines": [
        {
          "speaker": "Оксана:",
          "text": "[Ані|A-nee], [де|deh] [ти|ti] [живеш|zhi-VESH]?",
          "id": "Ani, where do you live?",
          "literal": "Ani, where — you — live?"
        },
        {
          "speaker": "Ані:",
          "text": "[Я|Ya] [живу|zhi-VOO] [в|v] [гуртожитку|hoor-TO-zhit-koo], [на|na] [Подолі|Po-DO-lee].",
          "id": "I live in the dorm, in Podil.",
          "literal": "I — live — in — dormitory, on — Podil."
        },
        {
          "speaker": "Оксана:",
          "text": "[О|O], [я|ya] [знаю|ZNA-yoo] [Поділ|Po-DEEL]. [Це|Tseh] [гарний|HAR-niy] [район|ra-YON].",
          "id": "Oh, I know Podil. It's a nice neighborhood.",
          "literal": "oh, I — know — Podil. this — nice — district."
        },
        {
          "speaker": "Ані:",
          "text": "[Так|Tak], [і|ee] [близько|BLIZ'-ko] [до|do] [університету|oo-nee-ver-si-TEH-too]. [А|A] [ви|vi] [де|deh] [живете|zhi-veh-TEH]?",
          "id": "Yes, and it's close to the university. And where do you live?",
          "literal": "yes, and — close — to — university (родовий). and — you — where — live?"
        },
        {
          "speaker": "Оксана:",
          "text": "[Я|Ya] [живу|zhi-VOO] [в|v] [квартирі|kvar-TI-ree] [на|na] [Лівому|LEE-vo-moo] [березі|BEH-reh-zee].",
          "id": "I live in an apartment on the Left Bank.",
          "literal": "I — live — in — apartment, on — left — bank."
        },
        {
          "speaker": "Ані:",
          "text": "[Це|Tseh] [далеко|da-LEH-ko]?",
          "id": "Is that far?",
          "literal": "this — far?"
        },
        {
          "speaker": "Оксана:",
          "text": "[Не|Neh] [дуже|DOO-zheh]. [Сорок|SO-rok] [хвилин|khvi-LIN] [на|na] [метро|met-RO].",
          "id": "Not very. Forty minutes by metro.",
          "literal": "not — very. forty — minutes (родовий) — on — metro."
        },
        {
          "speaker": "Ані:",
          "text": "[У|OO] [вас|vas] [велика|veh-LI-ka] [квартира|kvar-TI-ra]?",
          "id": "Is your apartment big?",
          "literal": "at — you — big — apartment?"
        },
        {
          "speaker": "Оксана:",
          "text": "[Три|Tri] [кімнати|keem-NA-ti]. [Я|Ya] [живу|zhi-VOO] [там|tam] [з|z] [чоловіком|cho-lo-VEE-kom] [і|ee] [сином|SI-nom].",
          "id": "Three rooms. I live there with my husband and son.",
          "literal": "three — rooms. I — live — there — with — husband (орудний) — and — son (орудний)."
        },
        {
          "speaker": "Ані:",
          "text": "[А|A] [в|v] [моїй|mo-YEEY] [кімнаті|keem-NA-tee] [тільки|TEEL'-ki] [ліжко|LEEZH-ko], [стіл|steel] [і|ee] [шафа|SHA-fa].",
          "id": "In my room there's just a bed, a table, and a wardrobe.",
          "literal": "and — in — my (місцевий) — room — only — bed, table — and — wardrobe."
        },
        {
          "speaker": "Оксана:",
          "text": "[Цього|TSYO-ho] [достатньо|dos-TAT-nyo], [коли|ko-LI] [ти|ti] [студентка|stoo-DENT-ka].",
          "id": "That's enough when you're a student.",
          "literal": "this (родовий) — enough, when — you — student (f)."
        },
        {
          "speaker": "Ані:",
          "text": "[Правда|PRAV-da]. [І|EE] [вікно|veek-NO] [з|z] [гарним|HAR-nim] [видом|VI-dom].",
          "id": "True. And a window with a nice view.",
          "literal": "true. and — window — with — nice (орудний) — view (орудний)."
        }
