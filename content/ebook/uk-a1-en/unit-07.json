{
  "title": "How old are you?",
  "title_target": "Скільки вам років? — Skilky vam rokiv?",
  "goal": "Count from zero to a thousand, give your age the way Ukrainians build it, and meet the third case (давальний, the dative) through its busiest doorway: age.",
  "bekal": [
    "count from zero to a hundred",
    "ask and give someone's age",
    "choose between рік, роки, and років",
    "give a phone number and a room number",
    "ask the price with Скільки коштує?"
  ],
  "dialogs": [
    {
      "title": "Діалог — Filling in a form at the dorm",
      "intro": "Ani is re-registering at the dormitory office. Notice that the word *рік* shows up in three different forms in this dialogue — and what decides the form isn't the age but its last digit.",
      "lines": [
        {
          "speaker": "Секретар:",
          "text": "[Скажіть|Ska-ZHEET'], [будь|bood'] [ласка|LAS-ka], [скільки|SKEEL'-ki] [вам|vam] [років|RO-keev]?",
          "id": "Could you tell me how old you are, please?",
          "literal": "tell, be — kindness, how-many — to-you — years?"
        },
        {
          "speaker": "Ані:",
          "text": "[Мені|Meh-NEE] [двадцять|DVAD-tsyat'] [один|o-DIN] [рік|reek].",
          "id": "I'm twenty-one.",
          "literal": "to-me — twenty — one — year."
        },
        {
          "speaker": "Секретар:",
          "text": "[Двадцять|DVAD-tsyat'] [один|o-DIN]... [А|A] [ваш|vash] [номер|NO-mer] [телефону|teh-leh-FO-noo]?",
          "id": "Twenty-one... And your phone number?",
          "literal": "twenty — one... and — your — number — phone (родовий)?"
        },
        {
          "speaker": "Ані:",
          "text": "[Нуль|Nool'] [сім|seem] [три|tri], [вісім|VEE-seem] [два|dva], [дев'ять|DEH-vyat'] [один|o-DIN].",
          "id": "Zero seven three, eight two, nine one.",
          "literal": "zero — seven — three, eight — two, nine — one."
        },
        {
          "speaker": "Секретар:",
          "text": "[Дякую|DYA-koo-yoo]. [Ви|Vi] [живете|zhi-veh-TEH] [в|v] [гуртожитку|hoor-TO-zhit-koo]?",
          "id": "Thank you. Do you live in the dorm?",
          "literal": "I-thank. you — live — in — dormitory?"
        },
