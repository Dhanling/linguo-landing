  "sections": [
    {
      "title": "Numbers change the word that follows them",
      "blocks": [
        {
          "type": "p",
          "text": "The same rule as *рік / роки / років* applies to every noun. Once you see the pattern, all numbers become easy."
        },
        {
          "type": "tabel",
          "head": [
            "Number",
