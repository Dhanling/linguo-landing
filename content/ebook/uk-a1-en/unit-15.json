{
  "title": "I like — and sentences that turn themselves around",
  "title_target": "Мені подобається — Meni podobayetsya",
  "goal": "Say what you like in two different ways, and understand the Ukrainian sentences that flip their structure, where \"I\" isn't the subject but the one on the receiving end.",
  "bekal": [
    "use подобатися with давальний (dative)",
    "tell любити from подобатися",
    "build sentences with no subject (мені треба, мені холодно)",
    "talk about your hobbies",
    "say you don't like something without sounding rude"
  ],
  "dialogs": [
    {
      "title": "Діалог — Afternoon coffee and different tastes",
      "intro": "Andriy and Ani talk about what they like. Notice that in *Мені подобається Київ* the subject isn't \"I\" but **Київ**, and that's why the verb is sometimes singular, sometimes plural.",
      "lines": [
        {
          "speaker": "Андрій:",
          "text": "[Ані|A-nee], [тобі|to-BEE] [подобається|po-DO-ba-yeh-tsya] [Київ|KI-yeev]?",
          "id": "Ani, do you like Kyiv?",
          "literal": "Ani, to-you — is-pleasing — Kyiv?"
        },
        {
          "speaker": "Ані:",
          "text": "[Дуже|DOO-zheh] [подобається|po-DO-ba-yeh-tsya]! [Особливо|O-sob-LI-vo] [Поділ|Po-DEEL].",
          "id": "I really like it! Especially Podil.",
          "literal": "very — is-pleasing! especially — Podil."
        },
        {
          "speaker": "Андрій:",
          "text": "[А|A] [що|shcho] [тобі|to-BEE] [там|tam] [подобається|po-DO-ba-yeh-tsya]?",
          "id": "What do you like there?",
          "literal": "and — what — to-you — there — is-pleasing?"
        },
        {
          "speaker": "Ані:",
          "text": "[Кав'ярні|Ka-VYAR-nee]. [І|EE] [люди|LYOO-di]. [Мені|Meh-NEE] [подобаються|po-DO-ba-yoot'-sya] [люди|LYOO-di] [тут|toot].",
          "id": "The coffee shops. And the people. I like the people here.",
          "literal": "coffee-shops. and — people. to-me — are-pleasing (pl.) — people — here."
        },
        {
          "speaker": "Андрій:",
          "text": "[А|A] [українська|oo-kra-YEEN-s'ka] [мова|MO-va]? [Подобається|Po-DO-ba-yeh-tsya]?",
          "id": "And Ukrainian? Do you like it?",
          "literal": "and — Ukrainian — language? is-pleasing?"
        },
        {
          "speaker": "Ані:",
          "text": "[Подобається|Po-DO-ba-yeh-tsya], [але|A-leh] [важко|VAZH-ko].",
          "id": "I like it, but it's hard.",
