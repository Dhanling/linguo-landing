        },
        {
          "speaker": "Андрій:",
          "text": "[Що|Shcho] [ти|ti] [любиш|LYOO-bish] [робити|ro-BI-ti] [у|oo] [вільний|VEEL'-niy] [час|chas]?",
          "id": "What do you like to do in your free time?",
          "literal": "what — you — love — to-do — in — free — time?"
        },
        {
          "speaker": "Ані:",
          "text": "[Люблю|Lyoob-LYOO] [читати|chi-TA-ti] [і|ee] [слухати|SLOO-kha-ti] [музику|MOO-zi-koo]. [А|A] [ти|ti]?",
          "id": "I love reading and listening to music. And you?",
          "literal": "love — to-read — and — to-listen — music (accusative). and — you?"
        },
        {
          "speaker": "Андрій:",
          "text": "[Я|Ya] [люблю|lyoob-LYOO] [футбол|foot-BOL]. [І|EE] [готувати|ho-too-VA-ti].",
          "id": "I love soccer. And cooking.",
          "literal": "I — love — soccer. and — to-cook."
