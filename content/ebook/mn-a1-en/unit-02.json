              "*kha-ran-DAA*",
              "pencil"
            ],
            [
              "*ширээ*",
              "*shi-RĒ*",
              "table, desk"
            ],
            [
              "*сандал*",
              "*SAN-dal*",
              "chair"
            ],
            [
              "*цонх*",
              "*tsonkh*",
              "window"
            ],
            [
              "*хаалга*",
              "*KHAAL-ga*",
              "door"
            ],
            [
              "*цүнх*",
              "*tsünkh*",
              "bag"
            ],
            [
              "*утас*",
              "*u-TAS*",
              "telephone; thread"
            ],
            [
              "*компьютер*",
              "*kom-P'YU-ter*",
              "computer"
            ],
            [
              "*цаас*",
              "*TSAAS*",
              "paper"
            ],
            [
              "*ус*",
              "*us*",
              "water"
            ],
            [
              "*аяга*",
              "*a-YA-ga*",
              "glass, cup"
            ],
            [
              "*түлхүүр*",
              "*TÜL-khüür*",
              "key"
            ],
            [
              "*мөнгө*",
              "*MÖN-gö*",
              "money"
            ]
          ]
        },
        {
          "type": "p",
          "text": "⚠️ *Утас* means both **telephone** and **thread**, and that's no coincidence: the phone was named after its wire, just as English still says \"on the line\". For a mobile phone, people say *гар утас* — literally \"hand phone\"."
        },
        {
          "type": "kotak",
          "title": "Three adjectives you can use right away",
          "items": [
            "*шинэ* (SHI-neh) — new. *хуучин* (KHUU-chin) — old, used.",
            "*том* (tom) — big. *жижиг* (JI-jig) — small.",
            "*сайн* (sain) — good. *муу* (muu) — bad.",
            "⚠️ Adjectives always stand **before** the noun and never change form: *шинэ ном*, *шинэ ширээ*, *шинэ оюутнууд*. No agreement at all — just like English."
          ]
        }
      ]
    },
    {
      "title": "Pointing: энэ, тэр, энд, тэнд",
      "blocks": [
        {
          "type": "p",
          "text": "These four words work in pairs, and all of them stand **before** the word they point to. Once you see the pattern, the four become one thing to learn, not four."
        },
        {
          "type": "tabel",
          "head": [
            "Near",
            "Say it",
            "Far",
            "Say it",
            "Meaning"
          ],
          "rows": [
            [
              "*энэ*",
              "*EH-neh*",
              "*тэр*",
              "*ter*",
              "this / that"
            ],
            [
              "*энд*",
              "*end*",
              "*тэнд*",
              "*tend*",
              "here / there"
            ],
            [
              "*ийш*",
              "*iish*",
              "*тийш*",
              "*tiish*",
              "(to) here / (to) there"
            ],
            [
              "*ингэж*",
              "*IN-gej*",
              "*тэгж*",
              "*tegj*",
              "like this / like that"
            ],
            [
              "*эдгээр*",
              "*ed-GĒR*",
              "*тэдгээр*",
              "*ted-GĒR*",
              "all this / all that"
            ]
          ]
        },
        {
          "type": "p",
          "text": "Notice that every \"near\" word starts with **э-** and every \"far\" word starts with **тэ-**. It's a reliable pattern used in a dozen other words. Once you've spotted it, you can guess the meaning of a new word before you look it up."
        },
        {
          "type": "tabel",
          "head": [
            "Question",
            "Answer",
            "Meaning"
          ],
          "rows": [
            [
              "*Энэ юу вэ?*",
              "*Энэ ном.*",
              "What's this? — It's a book."
            ],
            [
              "*Тэр юу вэ?*",
              "*Тэр цүнх.*",
              "What's that? — It's a bag."
            ],
            [
              "*Энэ хэн бэ?*",
              "*Энэ миний багш.*",
              "Who's this? — This is my teacher."
            ],
            [
              "*Ном хаана байна вэ?*",
              "*Ширээн дээр байна.*",
              "Where's the book? — It's on the table."
            ],
            [
              "*Энэ хэний юм бэ?*",
              "*Миний юм.*",
              "Whose is this? — It's mine."
            ]
          ]
        }
      ]
    },
    {
      "title": "Answering \"whose?\"",
      "blocks": [
        {
          "type": "p",
          "text": "There are two ways to answer, and Mongolians use both equally often. The second is shorter and more common in casual conversation."
        },
        {
          "type": "tabel",
          "head": [
            "Way",
            "Form",
            "Example",
            "Meaning"
          ],
          "rows": [
            [
              "Full",
              "owner + thing",
              "*Миний ном.*",
              "My book."
            ],
            [
              "Short",
              "owner + **-х**",
              "*Минийх.*",
              "Mine."
            ],
            [
              "Short",
              "owner + **-х**",
              "*Чинийх.*",
              "Yours (informal)."
            ],
            [
              "Short",
              "owner + **-х**",
              "*Таных.*",
              "Yours (formal)."
            ],
            [
              "Short",
              "owner + **-х**",
              "*Түүнийх.*",
              "His / Hers."
            ],
            [
              "Short",
              "name + **-ынх**",
              "*Болдынх.*",
              "Bold's."
            ]
          ]
        },
        {
          "type": "p",
          "text": "⚠️ The short form with **-х** has one extra use that is very common: it means **\"so-and-so's home/family\"**. *Болдынх* can mean \"Bold's (thing)\" or \"Bold's place\". *Би Болдынх руу явна* = \"I'm going to Bold's\". Exactly like English \"at Bold's\"."
        },
        {
          "type": "kotak",
          "title": "Ready-made patterns",
          "items": [
            "*Энэ хэний юм бэ?* — Whose is this?",
            "*Энэ минийх.* — It's mine.",
            "*Энэ миний ном биш.* — This isn't my book.",
            "*Тэр Сарнайнх.* — That's Sarnai's.",
            "*Мэдэхгүй, хэний ч биш байх.* — I don't know, maybe nobody's."
          ]
        }
      ]
    }
  ],
