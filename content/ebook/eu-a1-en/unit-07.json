            "Euskara",
            "English",
            "Example"
          ],
          "rows": [
            [
              "kilo bat",
              "a kilo",
              "kilo bat sagar"
            ],
            [
              "kilo erdi",
              "half a kilo",
              "kilo erdi tomate"
            ],
            [
              "laurden bat",
              "a quarter",
              "laurden bat gazta"
            ],
            [
              "dozena bat",
              "a dozen",
              "dozena bat arrautza"
            ],
            [
              "botila bat",
              "a bottle",
              "botila bat ur"
            ],
            [
              "zati bat",
              "a piece",
              "zati bat ogi"
            ],
            [
              "pakete bat",
              "a pack",
              "pakete bat kafe"
            ],
            [
              "gutxi / asko",
              "a little / a lot",
              "azukre gutxi"
            ]
          ]
        },
        {
          "type": "p",
          "text": "Notice that after a unit, the noun stays bare, without the article: *kilo bat sagar*, not *kilo bat sagarrak*. The rule is the same as for numbers in Unit 2."
        }
      ]
    }
  ],
