  "exercises": [
    {
      "prompt": "Make the comparative form asked for.",
      "items": [
        "garesti + more = ____",
        "merke + most = ____",
        "bero + too = ____",
        "handi + more = ____",
        "on + more = ____",
        "polit + most = ____"
      ]
    },
    {
      "prompt": "Translate into Basque.",
      "items": [
        "How much is it?",
        "A kilo of apples, please.",
        "It's too expensive.",
        "Bilbo is bigger than Donostia.",
        "Do you have it in another color?",
        "I'll take this one."
      ]
    },
