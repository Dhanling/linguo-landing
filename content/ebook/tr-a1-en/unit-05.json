    {
      "title": "Next to, across from, inside",
      "blocks": [
        {
          "type": "p",
          "text": "Turkish has no prepositions like *on* or *under*. What it has are **place nouns** that take a possessive ending and then *-de*. The pattern is always the same: *[thing]-nın [place]-ı-nda*."
        },
        {
          "type": "tabel",
          "head": [
            "Word",
            "Meaning",
            "Example",
            "English"
          ],
          "rows": [
            [
              "yan",
              "side",
