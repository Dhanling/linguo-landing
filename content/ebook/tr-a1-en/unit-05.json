  "exercises": [
    {
      "prompt": "Add the right location ending: *-de*, *-da*, *-te* or *-ta*.",
      "items": [
        "ev → ____",
        "okul → ____",
        "kitap → ____",
        "İstanbul → ____",
        "sınıf → ____",
        "Ankara → ____"
      ]
    },
    {
      "prompt": "Fill in the blanks with the right place word.",
      "items": [
        "Kitap masanın ____. (on top of)",
        "Eczane caminin ____. (across from)",
        "Market bankanın ____. (next to)",
        "Çanta sandalyenin ____. (under)",
        "Kafe okulun ____. (in front of)",
        "Anahtar çantanın ____. (inside)"
      ]
    },
    {
      "prompt": "Translate into Turkish.",
      "items": [
        "Where are you?",
        "I'm at home.",
        "We're at school.",
        "What's around you?",
        "There's a big mosque.",
        "There's a pharmacy across from the bank."
      ]
    },
    {
      "prompt": "Put the words in the right order.",
      "items": [
        "neredesin / sen / ?",
        "evdeyim / şimdi / ben",
        "var / ne / etrafında / ?",
        "üstünde / kitap / masanın",
        "yanında / bir / eczanenin / market / var",
        "değil / sorun"
      ]
    }
  ],
  "answers": [
    "evde — okulda — kitapta — İstanbul'da — sınıfta — Ankara'da",
    "üstünde — karşısında — yanında — altında — önünde — içinde",
    "Neredesin? — Evdeyim. — Okuldayız. — Etrafında ne var? — Büyük bir cami var. — Bankanın karşısında bir eczane var.",
    "Sen neredesin? — Ben şimdi evdeyim. — Etrafında ne var? — Masanın üstünde kitap. — Eczanenin yanında bir market var. — Sorun değil."
