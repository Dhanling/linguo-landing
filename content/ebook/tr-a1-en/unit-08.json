              "tramvay",
              "tram"
            ],
            [
              "dolmuş",
              "shared minibus",
              "minibüs",
              "minibus"
            ],
            [
              "taksi",
              "taxi",
              "araba",
              "car"
            ],
            [
              "tren",
              "train",
              "uçak",
              "plane"
            ],
            [
              "bisiklet",
              "bicycle",
              "iskele",
              "pier"
            ],
            [
              "durak",
              "stop",
              "istasyon",
              "station"
            ],
            [
              "bilet",
