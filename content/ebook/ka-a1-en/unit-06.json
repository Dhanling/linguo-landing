{
  "title": "How much is it?",
  "title_target": "რამდენი ღირს? — Ramdeni ghirs?",
  "goal": "Count to a hundred in a system that works in twenties, ask prices, bargain at the market, and understand why \"forty\" in Georgian is really \"two times twenty\".",
  "bekal": [
    "count 1–20 and build every number up to 100",
    "ask the price in two ways",
    "bargain politely at the market",
    "give quantities and weights when buying",
    "read prices written on shop labels"
  ],
  "dialogs": [
    {
      "title": "დიალოგი — At the Dezerter market",
      "intro": "Tbilisi's Dezerter market: fruit, cheese, spices, and vendors who always have an opinion about what you should buy. Ani is shopping for the week. Watch the numbers closely — the system will reveal itself in the grammar box.",
      "lines": [
        {
          "speaker": "ანი:",
          "text": "[უკაცრავად|Uk'-ats-ra-vad], [ეს|es] [ატამი|a-t'a-mi] [რამდენი|ram-de-ni] [ღირს|ghirs]?",
          "id": "Excuse me, how much are these peaches?",
          "literal": "excuse-me, this — peach — how-much — costs?"
        },
        {
          "speaker": "გამყიდველი:",
          "text": "[კილო|K'i-lo] [ხუთი|khu-ti] [ლარი|la-ri].",
          "id": "Five lari a kilo.",
          "literal": "kilo — five — lari."
        },
        {
          "speaker": "ანი:",
          "text": "[ორი|O-ri] [კილო|k'i-lo], [თუ|tu] [შეიძლება|she-idz-le-ba]. [ყველი|Q've-li] [გაქვთ|gakvt]?",
          "id": "Two kilos, please. Do you have cheese?",
          "literal": "two — kilo, if — possible. cheese — you-pl-have?"
        },
        {
          "speaker": "გამყიდველი:",
          "text": "[რა|Ra] [თქმა|tkma] [უნდა|un-da]. [სულგუნი|Sul-gu-ni] [ოცდაათი|ots-da-a-ti] [ლარი|la-ri] [კილო|k'i-lo].",
          "id": "Of course. Sulguni is thirty lari a kilo.",
          "literal": "what — saying — needed. sulguni — twenty-and-ten — lari — kilo."
        },
        {
          "speaker": "ანი:",
          "text": "[ოცდაათი|Ots-da-a-ti]?! [ცოტა|Tso-t'a] [ძვირია|dzvi-ri-a].",
          "id": "Thirty?! That's a bit expensive.",
          "literal": "twenty-and-ten?! a-little — expensive-is."
        },
        {
          "speaker": "გამყიდველი:",
          "text": "[კარგი|K'ar-gi] [ყველია|q've-li-a], [სოფლის|sop-lis]. [ნახევარი|Na-khe-va-ri] [კილო|k'i-lo] [თხუთმეტი|tkhut-me-t'i].",
          "id": "It's good cheese, from the village. Half a kilo is fifteen.",
          "literal": "good — cheese-is, village's. half — kilo — fifteen."
        },
        {
          "speaker": "ანი:",
          "text": "[ნახევარი|Na-khe-va-ri] [კილო|k'i-lo], [მაშინ|ma-shin]. [სულ|Sul] [რამდენი|ram-de-ni] [გამოვიდა|ga-mo-vi-da]?",
          "id": "Half a kilo, then. How much is that altogether?",
          "literal": "half — kilo, then. all — how-much — came-out?"
        },
        {
          "speaker": "გამყიდველი:",
          "text": "[ორი|O-ri] [კილო|k'i-lo] [ატამი|a-t'a-mi] [ათი|a-ti], [ყველი|q've-li] [თხუთმეტი|tkhut-me-t'i] — [ოცდახუთი|ots-da-khu-ti] [ლარი|la-ri].",
          "id": "Two kilos of peaches ten, cheese fifteen — twenty-five lari.",
          "literal": "two — kilo — peach — ten, cheese — fifteen — twenty-and-five — lari."
        },
        {
          "speaker": "ანი:",
          "text": "[აი|A-i], [ოცდაათი|ots-da-a-ti].",
          "id": "Here you go, thirty.",
