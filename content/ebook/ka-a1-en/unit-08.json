{
  "title": "What time is it?",
  "title_target": "რომელი საათია? — Romeli saatia?",
  "goal": "Tell the time, the day, and the date — and understand why \"half five\" in Georgian means 4:30, not 5:30.",
  "bekal": [
    "ask and tell the time",
    "name the days of the week and understand where the names come from",
    "make an appointment for a set time with the ending -ზე",
    "name the parts of the day: morning, midday, evening, night",
    "give the date and the month"
  ],
  "dialogs": [
    {
      "title": "დიალოგი — Scheduling a lesson",
      "intro": "Ani and her teacher Giorgi are setting up next week's lessons. Watch one line in the middle of the conversation — that's where Ani nearly makes the mistake that makes people show up an hour late.",
      "lines": [
        {
          "speaker": "გიორგი:",
          "text": "[ანი|A-ni], [ხვალ|khval] [გაკვეთილი|ga-k've-ti-li] [გვაქვს|gvakvs]. [რომელ|Ro-mel] [საათზე|sa-at-ze] [გირჩევნია|gir-chev-ni-a]?",
          "id": "Ani, we have a lesson tomorrow. What time would you prefer?",
          "literal": "Ani, tomorrow — lesson — we-have. which — hour-at — you-prefer?"
        },
        {
          "speaker": "ანი:",
          "text": "[დილით|Di-lit] [შეიძლება|she-idz-le-ba]? [ათ|At] [საათზე|sa-at-ze]?",
          "id": "Is the morning okay? At ten?",
          "literal": "morning-in — possible? ten — hour-at?"
        },
        {
          "speaker": "გიორგი:",
          "text": "[ათ|At] [საათზე|sa-at-ze] [სხვა|skhva] [გაკვეთილი|ga-k've-ti-li] [მაქვს|makvs]. [თერთმეტ|Tert-met'] [საათზე|sa-at-ze]?",
          "id": "At ten I have another class. At eleven?",
          "literal": "ten — hour-at — other — lesson — I-have. eleven — hour-at?"
        },
        {
          "speaker": "ანი:",
          "text": "[კარგი|K'ar-gi]. [ან|An] [თერთმეტის|tert-me-t'is] [ნახევარზე|na-khe-var-ze]?",
          "id": "Okay. Or at half eleven?",
          "literal": "good. or — eleven's — half-at?"
        },
        {
          "speaker": "გიორგი:",
          "text": "[თერთმეტის|Tert-me-t'is] [ნახევარი|na-khe-va-ri] [ათი|a-ti] [ოცდაათია|ots-da-a-ti-a], [არა|a-ra] [თერთმეტი|tert-me-t'i] [ოცდაათი|ots-da-a-ti].",
          "id": "Half eleven means 10:30, not 11:30.",
          "literal": "eleven's — half — ten — thirty-is, not — eleven — thirty."
        },
        {
          "speaker": "ანი:",
          "text": "[აჰ|Ah]! [ინდონეზიურად|In-do-ne-zi-u-rad] [იგივეა|i-gi-ve-a]. [კარგი|K'ar-gi], [თერთმეტ|tert-met'] [საათზე|sa-at-ze].",
          "id": "Oh! It's the same in Indonesian. Okay, at eleven.",
          "literal": "ah! in-Indonesian — same-is. good, eleven — hour-at."
        },
        {
          "speaker": "გიორგი:",
          "text": "[შესანიშნავია|She-sa-nish-na-vi-a]. [რომელი|Ro-me-li] [დღეა|dghe-a] [ხვალ|khval]?",
          "id": "Excellent. What day is it tomorrow?",
          "literal": "excellent-is. which — day-is — tomorrow?"
        },
        {
          "speaker": "ანი:",
          "text": "[ხვალ|Khval] [ოთხშაბათია|otkh-sha-ba-ti-a].",
          "id": "Tomorrow is Wednesday.",
          "literal": "tomorrow — four-Saturday-is."
        },
        {
          "speaker": "გიორგი:",
          "text": "[სწორია|Sts'o-ri-a]. [პარასკევს|P'a-ras-k'evs] [გამოცდა|ga-mots-da] [გვაქვს|gvakvs], [არ|ar] [დაგავიწყდეს|da-ga-vits'-q'des]!",
          "id": "Right. On Friday we have an exam, don't forget!",
