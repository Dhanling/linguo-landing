        },
        {
          "speaker": "ანი:",
          "text": "[რომელ|Ro-mel] [საათზე|sa-at-ze]?",
          "id": "At what time?",
          "literal": "which — hour-at?"
        },
        {
          "speaker": "გიორგი:",
          "text": "[ცხრის|Tskhris] [ნახევარზე|na-khe-var-ze] — [რვა|rva] [ოცდაათზე|ots-da-at-ze].",
          "id": "At half nine — 8:30.",
          "literal": "nine's — half-at — eight — thirty-at."
        },
        {
          "speaker": "ანი:",
          "text": "[გასაგებია|Ga-sa-ge-bi-a]! [რვა|Rva] [ოცდაათი|ots-da-a-ti]. [დავიმახსოვრებ|Da-vi-makh-sov-reb].",
          "id": "Got it! 8:30. I'll remember.",
          "literal": "understandable-is! eight — thirty. I'll-remember."
