 "dialogs": [
  {
   "title": "დიალოგი — Melihat apartemen sewaan",
   "intro": "Ani mencari tempat tinggal dan melihat sebuah apartemen bersama pemiliknya, Mzia. Perhatikan kata sifat yang mendahului kata benda — dan apa yang terjadi pada ekornya saat kata bendanya masuk ke dalam bentuk lain.",
   "lines": [
    {
     "speaker": "მზია:",
     "text": "[შემობრძანდით|She-mob-rdzan-dit]! [ეს|Es] [ბინა|bi-na] [პატარაა|p'a-t'a-ra-a], [მაგრამ|mag-ram] [ნათელი|na-te-li].",
     "id": "Silakan masuk! Apartemen ini kecil, tapi terang.",
     "literal": "masuklah! ini — apartemen — kecil-adalah, tetapi — terang."
    },
    {
     "speaker": "ანი:",
     "text": "[ლამაზია|La-ma-zi-a]. [რამდენი|Ram-de-ni] [ოთახია|o-ta-khi-a]?",
     "id": "Bagus. Ada berapa kamar?",
     "literal": "cantik-adalah. berapa — kamar-adalah?"
    },
    {
     "speaker": "მზია:",
     "text": "[ორი|O-ri] [ოთახი|o-ta-khi]: [საძინებელი|sa-dzi-ne-be-li] [და|da] [მისაღები|mi-sa-ghe-bi]. [სამზარეულო|Sam-za-re-u-lo] [აქ|ak] [არის|a-ris].",
     "id": "Dua kamar: kamar tidur dan ruang tamu. Dapurnya di sini.",
     "literal": "dua — kamar: tidur-tempat — dan — terima-tempat. dapur — di-sini — adalah."
    },
    {
     "speaker": "ანი:",
     "text": "[სამზარეულოში|Sam-za-re-u-losh-i] [მაცივარი|ma-tsi-va-ri] [არის|a-ris]?",
     "id": "Di dapur ada kulkas?",
     "literal": "dapur-dalam — kulkas — adalah?"
    },
    {
     "speaker": "მზია:",
     "text": "[კი|K'i], [მაცივარი|ma-tsi-va-ri], [ღუმელი|ghu-me-li] [და|da] [სარეცხი|sa-rets-khi] [მანქანა|man-ka-na] [არის|a-ris].",
     "id": "Ya, ada kulkas, kompor, dan mesin cuci.",
     "literal": "ya, kulkas, kompor — dan — cuci — mesin — adalah."
    },
    {
     "speaker": "ანი:",
     "text": "[ცხელი|Tskhe-li] [წყალი|ts'q'a-li] [მუდამ|mu-dam] [არის|a-ris]?",
     "id": "Air panasnya selalu ada?",
     "literal": "panas — air — senantiasa — adalah?"
    },
    {
     "speaker": "მზია:",
     "text": "[დიახ|Di-akh], [მუდამ|mu-dam]. [ინტერნეტიც|In-t'er-ne-t'its] [სწრაფია|sts'ra-pi-a].",
     "id": "Ya, selalu. Internetnya juga cepat.",
     "literal": "ya, senantiasa. internet-juga — cepat-adalah."
    },
    {
     "speaker": "ანი:",
     "text": "[რომელ|Ro-mel] [სართულზეა|sar-tul-ze-a]?",
     "id": "Di lantai berapa?",
     "literal": "yang-mana — lantai-di-atas-adalah?"
    },
    {
     "speaker": "მზია:",
     "text": "[მეოთხეზე|Me-ot-khe-ze]. [ლიფტი|Lip-t'i] [არ|ar] [არის|a-ris], [სამწუხაროდ|sam-ts'u-kha-rod].",
     "id": "Lantai empat. Sayangnya tidak ada lift.",
     "literal": "keempat-di-atas. lift — tidak — adalah, sayang-sekali."
    },
    {
     "speaker": "ანი:",
     "text": "[არა|A-ra] [უშავს|u-shavs]. [რამდენი|Ram-de-ni] [ღირს|ghirs] [თვეში|tve-shi]?",
